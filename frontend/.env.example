# Copy to `frontend/.env` and fill in.
# Vite exposes only VITE_-prefixed vars to browser code. Every value here is
# a public identifier, not a credential -- all are visible in the login
# redirect URL. Never put a secret in this file: it is compiled into the
# JavaScript bundle that ships to users.

VITE_ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000

# "organizations" = any Microsoft work/school account (multi-tenant).
# Use https://login.microsoftonline.com/<tenant-id> to restrict to one tenant.
VITE_ENTRA_AUTHORITY=https://login.microsoftonline.com/organizations

# Must exactly match a redirect URI registered under the app registration's
# "Single-page application" platform, trailing slash included.
VITE_ENTRA_REDIRECT_URI=http://localhost:5173

# Custom scope from "Expose an API" on the app registration.
VITE_API_SCOPE=api://00000000-0000-0000-0000-000000000000/access_as_user

# NOTE: no API base URL is needed. vite.config.ts proxies /api to the backend,
# so the browser calls it same-origin at a relative path -- no CORS setup.
