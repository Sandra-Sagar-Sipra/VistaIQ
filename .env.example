# Copy this file to `.env` and fill in real values.
#   cp .env.example .env
# `.env` is gitignored. Never commit real credentials.

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Postgres
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=5

# Key used to encrypt monitoring-source credentials at rest.
# Generate one with:  python -c "import secrets;print(secrets.token_urlsafe(32))"
CREDENTIALS_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Microsoft Entra ID (OAuth2 / OIDC)
# ---------------------------------------------------------------------------
# There is deliberately NO client secret here. VistaIQ's frontend is a
# single-page app, which is a PUBLIC client -- its code ships to the browser
# and cannot keep a secret. It uses PKCE instead. The backend never talks to
# Microsoft to log anyone in; it only VERIFIES tokens using Microsoft's
# public signing keys. If you find yourself needing a client secret, the app
# registration platform type is probably set to "Web" instead of
# "Single-page application".

# Application (client) ID from the Entra app registration.
# The backend requires this value in every access token's "aud" claim.
ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000

# Directory (tenant) ID of the home tenant.
ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000

# SECURITY BOUNDARY -- comma-separated list of tenant IDs allowed to sign in.
# The app registration is multi-tenant, so Microsoft will authenticate users
# from any organisation in the world. This allowlist is the only thing that
# stops them reaching VistaIQ data, because release one has no tenant
# isolation and no RBAC: everyone who gets past this line sees ALL data.
ALLOWED_TENANT_IDS=00000000-0000-0000-0000-000000000000

# Local development escape hatch (WBS task 3.4).
# When true, the API bypasses Entra and treats every request as a fixed test
# user, so development is not blocked on tenant access. The application
# REFUSES TO START if this is true while ENVIRONMENT != "development".
AUTH_BYPASS_ENABLED=false
AUTH_BYPASS_EMAIL=dev@local
